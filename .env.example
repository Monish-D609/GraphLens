# GraphLens Environment Variables
# Copy to .env: cp .env.example .env

# ════════════════════════════════════════════════════════
#  CLOUDFLARE  (PRIMARY — get free at dash.cloudflare.com)
# ════════════════════════════════════════════════════════
# 1. Go to https://dash.cloudflare.com → top-right → "My Profile" → "API Tokens"
# 2. Create Token → "Workers AI (read)" template
# 3. Your Account ID is visible on the right sidebar of any zone dashboard
CLOUDFLARE_ACCOUNT_ID=your_account_id_here
CLOUDFLARE_API_TOKEN=your_cf_api_token_here

# ════════════════════════════════════════════════════════
#  OPENROUTER  (FALLBACK — get free at openrouter.ai/keys)
# ════════════════════════════════════════════════════════
# No credit card required — free models include:
#   google/gemma-2-9b-it:free
#   meta-llama/llama-3.1-8b-instruct:free
#   mistralai/mistral-7b-instruct:free
OPENROUTER_API_KEY=sk-or-v1-your-key-here

# ════════════════════════════════════════════════════════
#  APP SETTINGS
# ════════════════════════════════════════════════════════
GRAPHLENS_ENV=development
LOG_LEVEL=INFO
FRONTEND_URL=http://localhost:5173
